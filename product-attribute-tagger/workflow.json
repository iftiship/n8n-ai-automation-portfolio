      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [2660, 240],
      "parameters": {
        "mode": "runOnceForEachItem",
        "language": "javaScript",
        "jsCode": "const meta = $(\"Pre-Flight & Normalize\").item.json || {};\nconst j = $input.item.json;\nlet rawText = \"\";\nlet provider = \"Gemini 3 Flash Vision\";\nlet isFallback = false;\nif (Array.isArray(j)) {\n  isFallback = true; provider = \"OpenAI GPT-4o-mini Vision (Fallback)\";\n  const msg = j.find(x => x && x.type === \"message\");\n  rawText = msg?.content?.find(c => c && c.type === \"output_text\")?.text || \"\";\n} else if (j && Array.isArray(j.output)) {\n  isFallback = true; provider = \"OpenAI GPT-4o-mini Vision (Fallback)\";\n  const msg = j.output.find(x => x && x.type === \"message\");\n  rawText = msg?.content?.find(c => c && c.type === \"output_text\")?.text || \"\";\n} else {\n  rawText = j?.content?.parts?.[0]?.text ?? j?.text ?? j?.output ?? \"\";\n}\nconst cleaned = String(rawText).replace(/```json\\s*/gi, \"\").replace(/```/g, \"\").trim();\nlet a = {};\ntry { const m = cleaned.match(/\\{[\\s\\S]*\\}/); if (m) a = JSON.parse(m[0]); } catch (_) {}\nconst str = (v, fb = \"Unspecified\") => { const s = String(v ?? \"\").trim(); return s ? s.slice(0, 180) : fb; };\nconst isGarment = a.is_garment_image !== false;\nconst confidence = Math.max(0, Math.min(100, Math.round(Number(a.confidence_score ?? 0) || 0)));\nconst rawHex = String(a.hex_estimate || \"\").trim();\nconst hex = /^#[0-9A-Fa-f]{6}$/.test(rawHex) ? rawHex.toUpperCase() : \"#64748B\";\nconst sec = Array.isArray(a.secondary_colours) ? a.secondary_colours.join(\", \") : str(a.secondary_colours, \"None\");\nconst tags = Array.isArray(a.merchandising_tags) ? a.merchandising_tags.join(\", \") : \"\";\nconst reasons = [];\nif (!isGarment) reasons.push(str(a.non_garment_reason, \"Non-garment image\"));\nif (confidence < 80) reasons.push(\"Low confidence (\" + confidence + \"% < 80%)\");\nif (meta.require_hitl) reasons.push(\"Manual HITL QA requested\");\nconst route = !isGarment ? \"non_garment\" : (reasons.length > 0 ? \"needs_hitl\" : \"auto_catalog\");\nreturn {\n  json: {\n    sku_id: meta.sku_id,\n    product_name: str(a.product_name, meta.hint_product_name || \"Untitled Garment\"),\n    garment_category: str(a.garment_category, \"Tops & Shirts\"),\n    primary_colour: str(a.primary_colour, \"Unknown\"),\n    secondary_colours_csv: sec,\n    colour_family: str(a.colour_family, \"Multicolour\"),\n    hex_estimate: hex,\n    fabric_material: str(a.fabric_material, \"Unknown\"),\n    fabric_weight: str(a.fabric_weight, \"Midweight\"),\n    texture_finish: str(a.texture_finish, \"Unknown\"),\n    design_type: str(a.design_type, \"Unknown\"),\n    pattern_motif: str(a.pattern_motif, \"Solid\"),\n    neckline_collar: str(a.neckline_collar, \"N/A\"),\n    sleeve_style: str(a.sleeve_style, \"N/A\"),\n    fit_silhouette: str(a.fit_silhouette, \"Regular Fit\"),\n    occasion_season: str(a.occasion_season, \"All-Season\"),\n    care_instructions: str(a.care_instructions, \"Follow care label\"),\n    merchandising_tags_csv: tags,\n    confidence_score: confidence,\n    vision_provider: provider,\n    fallback_attempted: isFallback,\n    is_garment_image: isGarment,\n    review_reason: reasons.join(\" | \"),\n    route,\n    status: route === \"auto_catalog\" ? \"Cataloged\" : (route === \"needs_hitl\" ? \"Needs Review\" : \"Rejected (Non-Garment)\"),\n    source_type: meta.source_type,\n    source_ref: meta.source_ref,\n    drive_file_id: meta.drive_file_id || \"\",\n    processed_at: new Date().toISOString()\n  }\n};"
      }
    },
