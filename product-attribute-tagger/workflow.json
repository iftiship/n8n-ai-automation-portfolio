        "jsCode": "const item = $input.item;\nconst bin = item.binary || {};\nconst binKey = Object.keys(bin)[0] || \"\";\nconst fileData = binKey ? bin[binKey] : null;\nconst cleanBin = fileData ? { data: fileData } : {};\nlet src = item.json || {};\nlet sourceType = \"webhook\";\nlet driveMeta = null;\ntry { driveMeta = $(\"Drive Garment Intake\").item.json; } catch (_) {}\nif (driveMeta && driveMeta.id) {\n  sourceType = \"google_drive\";\n  src = driveMeta;\n} else {\n  try {\n    const wh = $(\"Webhook Garment Intake\").item.json;\n    if (wh) src = (wh.body && typeof wh.body === \"object\") ? wh.body : wh;\n  } catch (_) {}\n}\nconst fileName = String(src.name || fileData?.fileName || src.product_title || \"garment.jpg\").trim();\nconst ref = String(src.id || src.sku_id || src.image_url || fileName);\nlet hash = 0;\nfor (let i = 0; i < ref.length; i++) { hash = ((hash << 5) - hash) + ref.charCodeAt(i); hash |= 0; }\nconst suffix = Math.abs(hash).toString(36).toUpperCase().padStart(4, \"0\").slice(0, 4);\nconst slug = fileName.replace(/\\.[^.]+$/, \"\").toUpperCase().replace(/[^A-Z0-9]+/g, \"-\").replace(/^-|-$/g, \"\").slice(0, 14) || \"ITEM\";\nconst skuId = String(src.sku_id || src.sku || \"\").trim().toUpperCase() || (\"GAR-\" + slug + \"-\" + suffix);\nconst mime = String(fileData?.mimeType || src.mimeType || \"\").toLowerCase().split(\";\")[0].trim();\nlet bytes = Number(fileData?.bytes || src.size || 0);\nif (!bytes && fileData?.data && !String(fileData.data).startsWith(\"filesystem\")) bytes = Math.floor(String(fileData.data).length * 0.75);\nconst allowed = [\"image/jpeg\", \"image/jpg\", \"image/png\", \"image/webp\", \"image/gif\"];\nlet err = item.json?.error?.message || \"\";\nif (!err && !fileData) err = \"No binary image found (provide valid image_url or file upload)\";\nelse if (!err && !allowed.includes(mime)) err = \"Unsupported media type: \" + (mime || \"unknown\");\nelse if (!err && bytes > 0 && bytes < 1024) err = \"Image too small (\" + bytes + \" bytes)\";\nelse if (!err && bytes > 15 * 1024 * 1024) err = \"Image exceeds 15 MB limit\";\nreturn {\n  json: {\n    sku_id: skuId,\n    source_type: sourceType,\n    source_ref: ref,\n    drive_file_id: sourceType === \"google_drive\" ? String(src.id || \"\") : \"\",\n    file_name: fileName,\n    hint_product_name: String(src.product_title || src.product_name || fileName.replace(/\\.[^.]+$/, \"\").replace(/[_-]+/g, \" \")),\n    require_hitl: Boolean(src.require_hitl),\n    is_valid_image: err === \"\",\n    rejection_reason: err\n  },\n  binary: cleanBin\n};"
