    {
      "parameters": {
        "jsCode": "const rows = $input.all().map(i => i.json);\nconst stockoutRisks = rows.filter(r => r.stock_qty <= r.reorder_point || Number(r.days_of_cover) < 5);\nconst slowMovers = rows.filter(r => Number(r.days_of_cover) > 30 && r.units_sold_7d <= 1);\n\nconst transferPairs = [];\nfor (const need of stockoutRisks) {\n  const donor = rows.find(d =>\n    d.sku_id === need.sku_id &&\n    d.size === need.size &&\n    d.store_id !== need.store_id &&\n    d.stock_qty >= d.reorder_point + 4\n  );\n  if (donor) {\n    transferPairs.push({\n      sku_id: need.sku_id,\n      product_name: need.product_name,\n      size: need.size,\n      from_store: donor.store_name,\n      from_qty: donor.stock_qty,\n      to_store: need.store_name,\n      to_qty: need.stock_qty,\n      suggested_qty: Math.min(4, Math.max(2, donor.stock_qty - donor.reorder_point - 2)),\n    });\n  }\n}\n\nconst needsAction = stockoutRisks.length > 0 || slowMovers.length > 0;\nreturn [{\n  json: {\n    needs_action: needsAction,\n    total_skus: rows.length,\n    stockout_risks: stockoutRisks,\n    slow_movers: slowMovers,\n    transfer_pairs: transferPairs,\n  }\n}];"
      },
      "id": "a1f2d8f9-fc82-4528-9cf5-2a9f3158ef2c",
      "name": "Compute Signals",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        544,
        224
      ]
    },
    {
