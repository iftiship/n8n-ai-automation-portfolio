    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const inq = $(\"Normalize Input\").item.json || {};\nconst raw = $input.item.json || {};\nconst out = (raw.output && typeof raw.output === \"object\") ? raw.output : raw;\nconst conf = Math.max(0, Math.min(100, Math.round(Number(out.confidence_score ?? 0) || 0)));\nconst escalate = Boolean(out.needs_human_escalation) || conf < 70 || !out.answer;\nconst reason = escalate ? String(out.escalation_reason || (conf < 70 ? \"Low RAG confidence (\" + conf + \"% < 70%)\" : \"Customer requested human assistance\")) : \"\";\nconst answer = String(out.answer || \"I am connecting you with our retail specialist who can assist you right away.\").trim();\nreturn {\n  json: {\n    session_id: inq.session_id,\n    channel: inq.channel,\n    customer_name: inq.customer_name,\n    customer_contact: inq.customer_contact,\n    question: inq.question,\n    answer,\n    intent_category: String(out.intent_category || \"general\"),\n    cited_policy_topic: String(out.cited_policy_topic || \"N/A\"),\n    confidence_score: conf,\n    escalated: escalate,\n    escalation_reason: reason,\n    status: escalate ? \"escalated\" : \"resolved\"\n  }\n};"
      },
