        "jsCode": "const raw = $input.first().json || {};\nconst body = (raw.body && typeof raw.body === \"object\") ? raw.body : raw;\nconst docs = Array.isArray(body.documents) ? body.documents : (body.text ? [body] : []);\nreturn docs.filter(d => d && String(d.text || d.content || \"\").trim()).map((d, idx) => ({\n  json: {\n    text: String(d.text || d.content).trim(),\n    topic: String(d.topic || \"General Policy\").trim(),\n    category: String(d.category || \"policy\").trim(),\n    doc_index: idx\n  }\n}));"
