        "jsonSchemaExample": "{\"answer\":\"Unworn garments with original tags can be exchanged within 15 days of delivery or purchase at any flagship store.\",\"confidence_score\":95,\"intent_category\":\"returns_exchanges\",\"needs_human_escalation\":false,\"escalation_reason\":\"\",\"cited_policy_topic\":\"Returns & Exchanges Policy\"}"
