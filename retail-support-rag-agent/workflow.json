        "jsCode": "const j = $input.item.json || {};\nconst src = (j.body && typeof j.body === \"object\") ? j.body : j;\nconst isChat = Boolean(j.chatInput !== undefined);\nconst question = String(src.chatInput || src.question || src.message || \"\").trim();\nconst sessionId = String(src.sessionId || src.session_id || \"retail-sess-\" + Date.now()).trim();\nreturn {\n  json: {\n    channel: isChat ? \"web_chat\" : \"webhook\",\n    session_id: sessionId,\n    customer_name: String(src.customer_name || \"Guest Customer\").trim(),\n    customer_contact: String(src.customer_contact || \"Not provided\").trim(),\n    question\n  }\n};"
